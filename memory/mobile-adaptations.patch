+        &.close {
+                transform: translateX(100%);
+                visibility: hidden;
+        }
+}
+
+/* Mobile / small screens (phones): the palette becomes a full-width panel
+   so every control (usage modes, multi-click buttons, settings) stays
+   reachable and comfortably sized. Desktop keeps its 24em side panel. */
+@media (max-width: 36em) {
+        #cplus-toolbar {
+                width: 100vw;
+                max-width: 100vw;
+                /* Respect device notches / rounded corners */
+                padding-bottom: env(safe-area-inset-bottom, 0);
+        }
 }
